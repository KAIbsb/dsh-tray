; ==================== dsh-tray 配置文件 ====================
; 本文件是托盘的唯一配置。修改保存后,下次启动托盘生效。
; 删除或注释某行 = 该项使用默认值/自动检测。
; This file is the tray's single configuration. Changes apply on the next start.
; Delete or comment a line to use the default / auto-detection for that item.
; ==========================================================

; Harness 网页地址(必写;端口由 url 推导,默认 3080)
; Harness web URL (required; the port is derived from it, default 3080)
url=http://127.0.0.1:3080

; 界面语言:zh / en(留空 = 跟随系统)
; UI language: zh / en (empty = follow the system)
lang=

; 崩溃自动重启:true / false
; Auto-restart on crash: true / false
autorestart=true

; 开机自启:true / false(同时写入 Windows 启动项)
; Start with Windows: true / false (also written to the Windows startup)
autostart=false

; 以下留空或删除 = 自动检测
; Empty or remove a line below to auto-detect:
;node=
;dshentry=
;dshworkdir=
;chrome=
