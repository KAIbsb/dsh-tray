; ==================== dsh-tray 配置文件 ====================
; 本文件是可选的。所有键都用 ; 或 # 注释掉时(默认),程序自动检测一切。
; 修改后保存,下次启动托盘生效。
;
; This file is optional. When every key is commented out (the default),
; dsh-tray auto-detects node, the dsh entry script, Chrome/Edge and the URL.
; Changes take effect the next time the tray starts.
; ==========================================================

; Node.js 可执行文件路径(留空自动检测)
; Path to node.exe (leave empty to auto-detect)
;node=C:\Program Files\nodejs\node.exe

; dsh 入口脚本路径(留空自动检测)
; Path to the dsh entry script (leave empty to auto-detect)
;dshentry=C:\Program Files\nodejs\node_modules\@deepseek-ai\dsh\lib\bin.js

; dsh 的工作目录(留空自动推断)
; Working directory for dsh (leave empty to infer)
;dshworkdir=C:\Program Files\nodejs\node_modules

; Chromium 系浏览器可执行文件(默认自动查找 Chrome / Edge)
; Chromium-family browser exe (auto-detects Chrome / Edge by default)
;chrome=C:\Program Files\Google\Chrome\Application\chrome.exe

; Harness 网页地址(与 port 二选一即可;设置 url 会自动反推端口)
; Harness web URL (either this or port; url wins and derives the port)
;url=http://127.0.0.1:3080

; 端口(设置后自动改写 url;默认 3080)
; Port (setting it rewrites url; default 3080)
;port=3080

; 界面语言:zh / en(留空跟随系统)
; UI language: zh / en (empty = follow the system)
;lang=zh
