; ==================== dsh-tray 配置文件 ====================
; 本文件是托盘的唯一配置。修改保存后,下次启动托盘生效。
; 留空 = 自动检测 / 默认值;填值 = 按所填使用。
; This file is the tray's single configuration. Changes apply on the next start.
; Empty = auto-detect / default; a value = use it.
; ==========================================================

; Harness 网页地址(默认 http://127.0.0.1:3080,改端口直接改这里;端口由 url 推导)
; 端口必须与 harness 实际监听端口一致(默认 3080);修改前请先在 harness 侧配置对应端口
; Harness web URL (default http://127.0.0.1:3080; change it here for a custom port, the port is derived from it)
; the port must match the port the harness actually listens on (default 3080); configure the harness side first when changing it
url=http://127.0.0.1:3080

; 界面语言:zh / en(留空 = 跟随系统)
; UI language: zh / en (empty = follow the system)
lang=

; 崩溃自动重启:true / false
; Auto-restart on crash: true / false
autorestart=true

; 开机自启:true / false(同时写入 Windows 启动项)
; Start with Windows: true / false (also written to the Windows startup)
autostart=false

; 主题:light / dark(留空 = 跟随系统)
; Theme: light / dark (empty = follow the system)
theme=

; Node.js 可执行文件路径(留空 = 自动检测)
; Path to node.exe (empty = auto-detect)
node=

; dsh 入口脚本路径(留空 = 自动检测)
; Path to the dsh entry script (empty = auto-detect)
dshentry=

; dsh 工作目录(留空 = 自动推断)
; Working directory for dsh (empty = inferred)
dshworkdir=

; Chromium 系浏览器可执行文件(留空 = 自动查找 Chrome / Edge)
; Chromium-family browser exe (empty = auto-detect Chrome / Edge)
chrome=
